{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileEntry"
      }
    },
    "firmware": {
      "$ref": "#/$defs/Firmware"
    },
    "format": {
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/Generator"
    },
    "manual_restore": {
      "description": "Shell commands to put each touched file back by hand over serial.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PayloadEntry"
      }
    },
    "reboot": {
      "type": "boolean"
    },
    "space": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpaceNeed"
      }
    },
    "tweaks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlannedTweak"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "generator",
    "firmware",
    "mode",
    "reboot",
    "entry",
    "tweaks",
    "files",
    "space",
    "payloads",
    "manual_restore",
    "warnings"
  ],
  "$defs": {
    "Action": {
      "type": "string",
      "enum": [
        "install",
        "uninstall"
      ]
    },
    "Evidence": {
      "oneOf": [
        {
          "description": "MZD-AIO-TI shipped it for this firmware; our implementation is unverified.",
          "type": "string",
          "const": "upstream"
        },
        {
          "description": "Verified by us on real hardware.",
          "type": "string",
          "const": "bench"
        }
      ]
    },
    "FileEntry": {
      "type": "object",
      "properties": {
        "backup": {
          "type": [
            "string",
            "null"
          ]
        },
        "ops": {
          "description": "`tweak:op` in execution order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partition": {
          "$ref": "#/$defs/Partition"
        },
        "path": {
          "type": "string"
        },
        "permanent": {
          "description": "Edited by a permanent prerequisite; never reverted.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "partition",
        "ops",
        "permanent"
      ]
    },
    "Firmware": {
      "type": "object",
      "properties": {
        "checked_on_cmu": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "profile_label": {
          "type": "string"
        },
        "requested": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "checked_on_cmu",
        "profile",
        "profile_label"
      ]
    },
    "Generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "upstream_ref": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "upstream_ref"
      ]
    },
    "Mode": {
      "oneOf": [
        {
          "description": "The CMU runs every preflight check, logs to the USB stick, and changes nothing.",
          "type": "string",
          "const": "check"
        },
        {
          "description": "Preflight, backups, then the changes.",
          "type": "string",
          "const": "apply"
        }
      ]
    },
    "Partition": {
      "type": "string",
      "enum": [
        "rootfs",
        "resources",
        "data_persist"
      ]
    },
    "PayloadEntry": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ]
    },
    "PlannedTweak": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "type": "string"
        },
        "options": {
          "description": "Options as given, with host files replaced by their size and hash.",
          "type": "object",
          "additionalProperties": true
        },
        "prerequisite": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepOp"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "action",
        "prerequisite",
        "evidence",
        "options",
        "steps"
      ]
    },
    "SpaceNeed": {
      "type": "object",
      "properties": {
        "backups": {
          "description": "Files whose backups land here; the CMU sizes them exactly before writing.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partition": {
          "$ref": "#/$defs/Partition"
        },
        "payload_bytes": {
          "description": "Upper bound of bytes added by appended blocks and installed files.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reserve_kib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "partition",
        "payload_bytes",
        "backups",
        "reserve_kib"
      ]
    },
    "StepOp": {
      "description": "One operation on the CMU, as written in the catalog. See data/tweaks.toml.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "require_file"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "applied": {
              "type": [
                "string",
                "null"
              ]
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "literal": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "require_literal"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "literal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "require_backup"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "backup"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string"
            },
            "block": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "append_block"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "block",
            "asset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "block": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "remove_block"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "block"
          ]
        },
        {
          "type": "object",
          "properties": {
            "find": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "replace_literal"
            },
            "path": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "find",
            "replace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "install_file"
            },
            "option": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "option"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "restore"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "op": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "op",
            "argv"
          ]
        }
      ]
    }
  }
}
