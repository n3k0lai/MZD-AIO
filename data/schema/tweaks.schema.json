{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TweaksFile",
  "type": "object",
  "properties": {
    "tweak": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tweak"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "tweak"
  ],
  "$defs": {
    "Compat": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "evidence"
      ]
    },
    "Evidence": {
      "oneOf": [
        {
          "description": "MZD-AIO-TI shipped it for this firmware; our implementation is unverified.",
          "type": "string",
          "const": "upstream"
        },
        {
          "description": "Verified by us on real hardware.",
          "type": "string",
          "const": "bench"
        }
      ]
    },
    "Risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "Step": {
      "description": "One operation on the CMU, as written in the catalog. See data/tweaks.toml.",
      "type": "object",
      "properties": {
        "unless": {
          "description": "Only include this step when the named bool option is false.",
          "type": [
            "string",
            "null"
          ]
        },
        "when": {
          "description": "Only include this step when the named bool option is true.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "require_file"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "applied": {
              "type": [
                "string",
                "null"
              ]
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "literal": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "require_literal"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "literal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "require_backup"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "backup"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string"
            },
            "block": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "append_block"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "block",
            "asset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "block": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "remove_block"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "block"
          ]
        },
        {
          "type": "object",
          "properties": {
            "find": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "replace_literal"
            },
            "path": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "find",
            "replace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "install_file"
            },
            "option": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "option"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "restore"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "op": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "op",
            "argv"
          ]
        }
      ]
    },
    "Tweak": {
      "type": "object",
      "properties": {
        "acknowledge": {
          "description": "Token the config must repeat to install a tweak that reduces driving safety.",
          "type": [
            "string",
            "null"
          ]
        },
        "acknowledge_why": {
          "type": [
            "string",
            "null"
          ]
        },
        "compat": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Compat"
          }
        },
        "id": {
          "type": "string"
        },
        "install": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "notes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "option": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TweakOption"
          }
        },
        "permanent": {
          "description": "Has no uninstall by design.",
          "type": "boolean",
          "default": false
        },
        "prerequisite": {
          "description": "Added automatically by tweaks that list it in `requires`; never user-selected.",
          "type": "boolean",
          "default": false
        },
        "requires": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Risk"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TweakStatus"
        },
        "summary": {
          "type": "string",
          "default": ""
        },
        "title": {
          "type": "string"
        },
        "uninstall": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "upstream": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "title"
      ]
    },
    "TweakOption": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "type": "string",
              "const": "bool"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A host PNG file, checked against an exact size.",
          "type": "object",
          "properties": {
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "png"
            },
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "width",
            "height"
          ]
        }
      ],
      "required": [
        "name",
        "description"
      ]
    },
    "TweakStatus": {
      "type": "string",
      "enum": [
        "ported",
        "unported"
      ]
    }
  }
}
